# Copy to .env.local and fill in values

# Go Gateway  (main.go: r.Run(":8081"))
VITE_API_BASE=http://localhost:8081
VITE_WS_BASE=ws://localhost:8081

# Anthropic API key (required for AI agent features)
VITE_ANTHROPIC_KEY=sk-ant-...

# ── Backend route reference ───────────────────────────────────────────────
# POST /doctor/login          { name, password }   → { message, doctor, token }
# POST /doctor/register       DoctorModel          → { message, data }
# GET  /ws                    WebSocket            → ASREvent stream
# POST /register              RegisteredModel      → patient slot booking
# POST /doctor/main/test      (JWT protected)      → { message: "ok" }
